# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/vehicle-image-processor
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/vehicle-image-processor
MONGODB_URI=mongodb://localhost:27017/vehicle-image-processor

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Queue Configuration
QUEUE_CONCURRENCY=2
QUEUE_RETRY_ATTEMPTS=3

# Image Analysis Thresholds
BLUR_THRESHOLD=100
BRIGHTNESS_MIN=40
BRIGHTNESS_MAX=220
DUPLICATE_THRESHOLD=8
MIN_WIDTH=200
MIN_HEIGHT=200

# Logging
LOG_LEVEL=info
